# ----------------------------------------------------------------------------
# AI QA agent — environment template
#
# Copy this file to `.env` (same folder) and fill in the keys you actually use.
# `.env` is gitignored. Never commit real keys.
#
#   cp .env.example .env
# ----------------------------------------------------------------------------

# ============================================================================
# 1. Which provider runs the PR review?
# ============================================================================
# Options: anthropic | openai | bedrock
# Default: anthropic (Claude). Set this once; the agent reads it on startup.
PROVIDER=anthropic


# ============================================================================
# 2. Anthropic (Claude) — used for PR review
# ============================================================================
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional: override the model. Default below is a recent Sonnet.
# ANTHROPIC_MODEL=claude-sonnet-4-6


# ============================================================================
# 3. OpenAI — secondary provider / future test-generation jobs
# ============================================================================
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME

# Optional: model override. Defaults to gpt-4o-mini for cost.
# OPENAI_MODEL=gpt-4o-mini


# ============================================================================
# 4. AWS Bedrock (Claude on AWS) — OPTIONAL, only if you need it
# ============================================================================
# You usually don't. Use Bedrock only if:
#   • Your org requires LLM traffic stay inside AWS for compliance.
#   • You have AWS credits / negotiated Bedrock pricing.
#   • You're already on AWS infra and want consolidated billing.
# Otherwise the direct Anthropic API (above) is simpler and equivalent.
#
# To enable: set PROVIDER=bedrock and fill these:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
#
# Default above is Amazon Nova Pro — no third-party gate, available immediately.
# Other tested options:
#   us.amazon.nova-lite-v1:0                          (cheaper, lower quality)
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0      (requires Anthropic use-case form)
#   us.meta.llama3-3-70b-instruct-v1:0                (open-weight)
#
# The "us." prefix uses Bedrock's cross-region inference profile (better
# availability). Drop it to pin a single region.


# ============================================================================
# 5. GitHub — required so the agent can read the PR diff and post comments
# ============================================================================
# In GitHub Actions this is provided automatically as ${{ secrets.GITHUB_TOKEN }}.
# Locally (for --diff-file dry runs) you don't need it. For CircleCI runs,
# create a Classic PAT with `repo` scope and set it in CircleCI env vars.
# GITHUB_TOKEN=ghp_REPLACE_ME


# ============================================================================
# 6. Misc
# ============================================================================
# Cap on tokens per LLM call. Bump if your PRs are large.
# MAX_TOKENS=2048
